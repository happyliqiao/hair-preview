.page {
  position: relative;
  width: 100%;
  height: 100vh;
  background: #15151E;
  overflow: hidden;
}

.stage {
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

.overlay {
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  height: 100%;
  z-index: 2;
  pointer-events: none;
}

.capture-canvas {
  position: fixed;
  left: -9999rpx;
  width: 2rpx; height: 2rpx;
}

.guide {
  position: absolute;
  top: 160rpx;
  left: 0; right: 0;
  text-align: center;
  color: rgba(255, 255, 255, .8);
  font-size: 26rpx;
  z-index: 3;
}

.topbar {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 100rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 32rpx;
  padding-top: env(safe-area-inset-top);
  color: #fff;
  z-index: 3;
}
.topbar .back { font-size: 48rpx; }
.topbar .title { font-size: 32rpx; font-weight: 600; }
.topbar .tag {
  margin-left: auto;
  font-size: 22rpx;
  color: #9FD0FF;
  background: rgba(90, 139, 255, .2);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.panel {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  background: #fff;
  border-radius: 48rpx 48rpx 0 0;
  padding: 32rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  z-index: 3;
}
.row-label {
  font-size: 26rpx;
  color: #8A8F9C;
  margin: 8rpx 0 20rpx;
}
.hs-row { white-space: nowrap; margin-bottom: 28rpx; }
.hs-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  margin-right: 24rpx;
}
.hs-item .thumb {
  width: 116rpx; height: 116rpx;
  border-radius: 24rpx;
  background: #F1EEF8;
  border: 4rpx solid transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
}
.hs-item.on .thumb { border-color: #6C4CF1; background: #EFEAFF; }
.hs-item .nm { font-size: 22rpx; color: #6A707C; margin-top: 10rpx; }

.color-row { display: flex; flex-wrap: wrap; gap: 20rpx; margin-bottom: 32rpx; }
.swatch {
  width: 64rpx; height: 64rpx;
  border-radius: 50%;
  border: 4rpx solid #fff;
  box-shadow: 0 0 0 3rpx #DCDCE4;
}
.swatch.on { box-shadow: 0 0 0 5rpx #6C4CF1; }

.capture {
  width: 100%;
  padding: 26rpx 0;
  font-size: 32rpx;
}

/* 结果弹层 */
.result-mask {
  position: absolute;
  inset: 0;
  background: rgba(20, 20, 30, .7);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  z-index: 10;
}
.result-card {
  width: 100%;
  background: #fff;
  border-radius: 40rpx;
  padding: 40rpx 32rpx;
}
.result-title { font-size: 36rpx; font-weight: 700; margin-bottom: 24rpx; }
.cmp { display: flex; gap: 20rpx; margin-bottom: 32rpx; }
.cmp-box {
  flex: 1;
  border-radius: 24rpx;
  background: #F7F6FB;
  padding: 12rpx 12rpx 16rpx;
  border: 1px solid #ECECF2;
}
.cmp-lab { font-size: 24rpx; color: #8A8F9C; display: block; text-align: center; margin-bottom: 12rpx; }
.cmp-box image { width: 100%; height: 260rpx; }
.btn-line {
  width: 100%;
  margin-top: 20rpx;
  padding: 24rpx 0;
  border-radius: 28rpx;
  border: 1px solid #DCDCE4;
  background: #fff;
  font-size: 30rpx;
  font-weight: 600;
}
.btn-line::after { border: none; }
.btn-text {
  margin-top: 28rpx;
  text-align: center;
  color: #8A8F9C;
  font-size: 28rpx;
}

/* 演示模式标识 */
.demo-badge {
  display: inline-block;
  margin-left: 12rpx;
  font-size: 20rpx;
  font-weight: 500;
  color: #FF8A5C;
  background: rgba(255, 138, 92, .12);
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
  vertical-align: middle;
}
.demo-tip {
  font-size: 22rpx;
  color: #8A8F9C;
  line-height: 1.6;
  background: #F7F6FB;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
}
